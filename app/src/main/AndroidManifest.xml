<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Keep the SDK capability explicit instead of relying on a dependency manifest. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <application
        android:name=".processing.ProcessingApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContentStudio"
        tools:targetApi="33">
        <!-- Build-type configuration keeps UMP and SDK IDs aligned; release stays inactive. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${adApplicationId}" />
        <!-- Ad dependencies must not open a WorkManager database during ordinary media startup. -->
        <provider android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup" android:exported="false" tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove" />
        </provider>
        <provider
            android:name=".media.OutputFileProvider"
            android:authorities="${applicationId}.outputs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/output_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.ContentStudio.Starting"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".processing.ProcessingService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
        <service
            android:name=".media.PdfPageService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":pdf_pages" />
        <service
            android:name=".media.PdfRenderService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":pdf_renderer" />
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
    </application>
</manifest>
