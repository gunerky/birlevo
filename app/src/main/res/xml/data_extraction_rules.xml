<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Saved content URI permissions do not transfer to another device. -->
    <cloud-backup>
        <exclude domain="file" path="projects.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="projects.json" />
    </device-transfer>
</data-extraction-rules>
