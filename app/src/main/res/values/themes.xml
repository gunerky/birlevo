<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ContentStudio.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- API 24/25 cannot draw dark navigation icons: preserve a contrasting navy bar. -->
        <item name="android:navigationBarColor">#08164D</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.ContentStudio" parent="Theme.ContentStudio.Base" />
    <style name="Theme.ContentStudio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#08164D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ContentStudio</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
